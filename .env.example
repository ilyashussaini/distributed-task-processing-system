# Local development values. Use deployment-specific credentials outside local development.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=tasks
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

REDIS_STREAM=task-system:jobs
MAX_ATTEMPTS=3
ATTEMPT_TIMEOUT_SECONDS=30
ENABLE_RECOVERY_DEMO=false
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=60
LEASE_SECONDS=30
REDISPATCH_SECONDS=15
POLL_MS=500
DISPATCH_BATCH_SIZE=50

# Optional overrides for processes run directly on the host.
# DATABASE_URL=postgresql+psycopg://tasks:local-dev-password@127.0.0.1:5432/tasks
# REDIS_URL=redis://127.0.0.1:6379/0
